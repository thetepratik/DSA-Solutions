You are given the head of a singly linked list, you have to left rotate the linked list k times. Return the head of the modified linked list.

Examples:
Input: k = 4,
Output: 50 -> 10 -> 20 -> 30 -> 40
Explanation:
Rotate 1: 20 -> 30 -> 40 -> 50 -> 10
Rotate 2: 30 -> 40 -> 50 -> 10 -> 20
Rotate 3: 40 -> 50 -> 10 -> 20 -> 30
Rotate 4: 50 -> 10 -> 20 -> 30 -> 40
   
Input: k = 6,
Output: 30 -> 40 -> 10 -> 20 
   
Constraints:
1 ≤ number of nodes ≤ 10^5
0 ≤ k ≤ 10^9
0 ≤ node.data ≤ 10^9


Code:
/*
class Node {
    int data;
    Node* next;

    Node(int x) {
        data = x;
        next = NULL;
    }
};
*/

class Solution {
  public:
  void reversenum(vector<int>& num, int start, int end){
    //   int start = 0, end = num.size()-1;
        while(start < end){
          int temp = num[start];
          num[start] = num[end];
          num[end] = temp;
          start++;
          end--;
      }
  }
    Node* rotate(Node* head, int k) {
        // code here
        if(head==nullptr) return head;
        vector<int> ans;
        Node* temp = head;
        while(temp != nullptr){
            ans.push_back(temp->data);
            temp = temp->next;
        }
        
        int n = ans.size();
        k = k % n;
        
        reversenum(ans, 0, k-1);
        reversenum(ans, k, n-1);
        reversenum(ans, 0, n-1);
        
        Node* dummy = new Node(0);
        temp = dummy;
        for(int i=0;i<n;i++){
            temp->next = new Node(ans[i]);
            temp = temp->next;
        }
        return dummy->next;
    }
};
