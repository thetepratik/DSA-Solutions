
Given one meeting room and N meetings represented by two arrays, start and end, where start[i] represents the start time of the ith meeting and end[i] 
represents the end time of the ith meeting, determine the maximum number of meetings that can be accommodated in
the meeting room if only one meeting can be held at a time. A meeting starting at the same time another meeting ends is considered overlapping.

Example 1:
Input : Start = [1, 3, 0, 5, 8, 5] , End = [2, 4, 6, 7, 9, 9]
Output : 4
Explanation : The meetings that can be accommodated in meeting room are (1,2) , (3,4) , (5,7) , (8,9).

Example 2:
Input : Start = [10, 12, 20] , End = [20, 25, 30]
Output : 1
Explanation : Given the start and end time, only one meeting can be held in meeting room.

Constraints:
1 <= N <= 10^5
0 <= start[i] < end[i] <= 10^5

Code:
class Solution{
    public:
    int maxMeetings(vector<int>& start, vector<int>& end){
        //your code goes here
        vector<pair<int, int>> ans;
        int n = start.size();

        for(int i=0;i<n;i++){
            ans.push_back({start[i], end[i]});
        }

        sort(ans.begin(), ans.end(), [](const auto& a, const auto& b){
           return a.second < b.second;
        });
        int count = 1;
        int ansend = ans[0].second;

        for(int i=0;i<n;i++){
            if(ans[i].first > ansend){
                ansend = ans[i].second;
                count++;
            }
        }
        return count;
    }
};
