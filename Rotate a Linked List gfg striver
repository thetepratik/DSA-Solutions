You are given the head of a singly linked list, you have to left rotate the linked list k times. Return the head of the modified linked list.

Examples:

Input: k = 4,
   
Output: 50 -> 10 -> 20 -> 30 -> 40
Explanation:
Rotate 1: 20 -> 30 -> 40 -> 50 -> 10
Rotate 2: 30 -> 40 -> 50 -> 10 -> 20
Rotate 3: 40 -> 50 -> 10 -> 20 -> 30
Rotate 4: 50 -> 10 -> 20 -> 30 -> 40
   
Input: k = 6,
   
Output: 30 -> 40 -> 10 -> 20 
   
Constraints:

1 ≤ size of linked list ≤ 105
0 ≤ node.data, k ≤ 109

Code:
/*
class Node {
    int data;
    Node* next;

    Node(int x) {
        data = x;
        next = NULL;
    }
};
*/

class Solution {
  public:
    void reverselink(vector<int>& ans, int left, int right){
        while(left < right){
            swap(ans[left++], ans[right--]);
        }
    }
    Node* rotate(Node* head, int k) {
        // code here
        Node* temp = head;
        vector<int> ans;
        while(temp != nullptr){
            ans.push_back(temp->data);
            temp = temp->next;
        }
        int n = ans.size();
        k = k % n;
        if (k == 0) return head;
        reverselink(ans, 0, k-1);
        reverselink(ans, k, n-1);
        reverselink(ans, 0, n-1);
        
        temp = head;
        
        for(int i=0;i<n;i++){
            temp->data = ans[i];
            temp = temp->next;
        }
        return head;
    }
};
