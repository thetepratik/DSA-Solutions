class Solution{
    public:
    bool solve(vector<int> nums, int k, int sum, int index){
        if(index >= nums.size()){
            if(sum == k){
                return true;
            }else{
                return false;
            }
        }
        int curr = nums[index];
        bool exclude = solve(nums, k, sum, index+1);
        bool include = solve(nums, k, sum+curr, index+1);

        return exclude || include;

    }
    bool checkSubsequenceSum(vector<int>& nums, int k) {
