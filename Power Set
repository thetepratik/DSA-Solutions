You are given a string. You need to return the power set (in any order) of the string.

Examples:

Input: s = a
Output: ["","a"]
Explanation: empty string and "a" are only sets.

Input: s = abc
Output: ["", "a", "ab", "abc", "ac", "b", "bc", "c"]
Explanation: empty string, a, ab, abc, ac, b, bc, c are the sets.

Constraints:
1 ≤ s.size() ≤ 10

Code:
class Solution {
  public:
    void solve(int i, string& s, string curr, vector<string>& ans){
        if(i == s.length()){
            ans.push_back(curr);
            return;
        }
        
        solve(i+1, s, curr + s[i], ans);
        solve(i+1, s, curr, ans);
    }
    vector<string> powerSet(string s) {
        // code here
        vector<string> ans;
        solve(0, s, "", ans);
        return ans;
    }
};
