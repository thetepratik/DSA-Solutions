Given an array nums and an integer k.Return the number of non-empty subsequences of nums such that the sum of all elements in the subsequence is equal to k.

Example 1:
Input : nums = [4, 9, 2, 5, 1] , k = 10

Output : 2

Explanation : The possible subsets with sum k are [9, 1] , [4, 5, 1].

Example 2:
Input : nums = [4, 2, 10, 5, 1, 3] , k = 5

Output : 3

Explanation : The possible subsets with sum k are [4, 1] , [2, 3] , [5].

Let’s go through a few more examples, step by step, to make it clearer.

Constraints:
1 <= nums.length <= 20
1 <= nums[i] <= 100
1 <= k <= 2000

Code:
class Solution{
    public: 

    int solve(vector<int> nums, int k, int sum, int index){
        if(index >= nums.size()){
            if(sum == k){
                return 1;
            }else{
                return 0;
            }
        }

        int num = nums[index];
        int ans1 = solve(nums, k, sum, index+1);
        int ans2 = solve(nums, k, sum + num, index+1);
        return ans1 + ans2;

    }   	

    int countSubsequenceWithTargetSum(vector<int>& nums, int k){
    	//your code goes here
        int index = 0;
        int sum = 0;

        int ans = solve(nums, k, sum, index);
        return ans;
    }
};
