Given a linked list that is sorted in alternating ascending and descending order, sort the linked list in non-decreasing order.

Examples:

Input: head: 13 -> 99 ->21 -> 80 -> 50
Output: 13 -> 21-> 50 -> 80 -> 99
Explanation: After sorting the given linked list, the elements are arranged in non-decreasing order.

Input: head: 1 -> 9 -> 2 -> 8 -> 3 -> 7
Output: 1 -> 2 -> 3 -> 7 -> 8 -> 9

Explanation: After sorting the given linked list, the elements are arranged in non-decreasing order.
Constraints:

1 ≤ size of linked list ≤ 10^4
0 ≤ node.data ≤ 10^4

Code:
/* Structure of Linked List Node
class Node {
    int data;
    Node *next;

    Node(int x) {
        data = x;
        next = nullptr;
    }
};
*/
class Solution {
  public:
    Node* sort(Node* head) {
        // code here
        if(head == nullptr || head->next == nullptr) return head;
        Node* temp = head;
        vector<int> ans;
        
        while(temp != nullptr){
            ans.push_back(temp->data);
            temp = temp->next;
        }
        
        std::sort(ans.begin(), ans.end());
        
        temp = head;
        for(int i=0;i<ans.size();i++){
            temp->data = ans[i];
            temp = temp->next;
        }
        
        return head;
    }
};
